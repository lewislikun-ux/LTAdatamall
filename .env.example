# ==========================================
# LTA DataMall v3 Integration
# ==========================================
# LTA_ACCOUNT_KEY: Your Land Transport Authority (LTA) DataMall AccountKey
# Obtained from your email registration with LTA DataMall.
# Required for live /api/bus-arrival queries.
LTA_ACCOUNT_KEY="YOUR_LTA_ACCOUNT_KEY"

# ==========================================
# Multi-Provider LLM Keys (Configure in Vercel)
# ==========================================
# Google Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI API key (optional for OpenAI models like gpt-4o-mini)
OPENAI_API_KEY=""

# Anthropic API key (optional for Claude models)
ANTHROPIC_API_KEY=""

# Groq API key (optional for ultra-fast Llama-3 models)
GROQ_API_KEY=""

# OpenRouter API key (optional for all open-source & commercial models)
OPENROUTER_API_KEY=""

# Application Host URL
APP_URL="MY_APP_URL"
